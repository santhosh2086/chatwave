PORT=5000
# Local MongoDB default. For Atlas, use your own mongodb+srv URI.
MONGODB_URI=mongodb://127.0.0.1:27017/chatwave
# Generate a random secret of at least 32 characters; never commit real secrets.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
# Frontend origin. If your frontend itself is exposed through ngrok, use that frontend HTTPS URL.
CLIENT_URL=http://localhost:5173
# Groq API configuration (optional until using AI)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# For xAI instead, set AI_PROVIDER=xai and configure XAI_API_KEY + XAI_BASE_URL=https://api.x.ai/v1
# Optional DNS override for networks with blocked SRV lookups:
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Twilio Verify credentials required for real SMS OTP signup
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Instagram Login OAuth (optional). Use the App ID/Secret from the Instagram API setup with Instagram Login.
# Add the exact callback URL below to the Valid OAuth Redirect URIs allow-list in Meta Developer settings.
INSTAGRAM_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
# Optional alias if your deployment uses this name; INSTAGRAM_APP_ID takes precedence.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_APP_SECRET=
# Replace the host with your public HTTPS ngrok BACKEND URL. This must match Meta settings character-for-character.
INSTAGRAM_REDIRECT_URI=https://YOUR-BACKEND-NGROK-URL/api/instagram/oauth/callback
# Generate 32 random bytes and store as 64 hex characters. Used to encrypt per-user tokens at rest.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Public URL media downloader limit (default 100 MB)
MEDIA_DOWNLOAD_MAX_MB=100

# Maximum streamed Instagram video download size (MB).
INSTAGRAM_DOWNLOAD_MAX_MB=500
